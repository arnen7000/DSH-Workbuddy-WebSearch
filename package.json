{
  "name": "dsh-workbuddy-websearch",
  "version": "0.3.7",
  "description": "将 WorkBuddy 桌面 App 的网络搜索接入 DeepSeek Harness 的 web_search 工具（零配置、零硬依赖）",
  "versionNote": "0.3.7：精简仓库与发布物。测试体系、兼容性矩阵、规范审计、开发环境、上架流程这五份开发文档不再随仓库和 npm 包分发，只保留用户需要的 README 与许可文件；README 里原先外链到这些文档的说明改为就地写清，变更记录压缩为一行要点。安装方式、配置项、运行时行为全部不变，本版运行时逻辑一行未改。",
  "author": "XingLang & WorkBuddy (小研)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnen7000/DSH-Workbuddy-WebSearch.git"
  },
  "homepage": "https://github.com/arnen7000/DSH-Workbuddy-WebSearch#readme",
  "bugs": {
    "url": "https://github.com/arnen7000/DSH-Workbuddy-WebSearch/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "web-search"
  ],
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.2"
  },
  "os": [
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./platform": "./lib/platform.mjs",
    "./credentials": "./lib/credentials.mjs",
    "./decrypt": "./lib/decrypt.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.2",
      "dshReleases": {
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "dsh-workbuddy-connect": ">=0.5.4"
  },
  "peerDependenciesMeta": {
    "dsh-workbuddy-connect": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
