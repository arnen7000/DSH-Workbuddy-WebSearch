{
  "name": "dsh-workbuddy-websearch",
  "version": "0.3.2",
  "description": "将 WorkBuddy 桌面 App 的网络搜索接入 DeepSeek Harness 的 web_search 工具（零配置、零硬依赖）",
  "versionNote": "0.3.2：为插件市场的详情页补充界面截图。① 新增 screenshots.json，声明两张界面截图（插件列表里的已安装条目、插件详情页显示的版本号与运行状态），市场的 App Store 式详情页会直接采用。② 新增 assets/ 目录存放截图，路径相对 screenshots.json —— 之后想换图只需推自己的仓库，下一次构建自动生效，不必再提收录 PR。③ 运行时行为与 0.3.1 完全相同，无功能变更。",
  "author": "XingLang & WorkBuddy (小研)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnen7000/DSH-Workbuddy-WebSearch.git"
  },
  "homepage": "https://github.com/arnen7000/DSH-Workbuddy-WebSearch#readme",
  "bugs": {
    "url": "https://github.com/arnen7000/DSH-Workbuddy-WebSearch/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "web-search"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./platform": "./lib/platform.mjs",
    "./credentials": "./lib/credentials.mjs",
    "./decrypt": "./lib/decrypt.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.2",
      "dshReleases": {
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "dsh-workbuddy-connect": ">=0.5.4"
  },
  "peerDependenciesMeta": {
    "dsh-workbuddy-connect": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "COMPATIBILITY.md",
    "TESTING.md",
    "NORM-COMPLIANCE.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
